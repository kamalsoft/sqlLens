{
  "name": "sqllens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cleanStart": "clear && rm -rf .next && npm run build && npm run dev",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
