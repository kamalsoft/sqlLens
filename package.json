    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@azure/identity": "^4.14.1",
    "zod": "^4.6.7",
    "brace-expansion@<2": "^1.1.22",
    "brace-expansion@>=4": "^5.0.13"
